# LogiLead AI Configuration

# Tender sites to scrape (comma-separated URLs)
LOGILEAD_TENDER_SITES=https://example1.com,https://example2.com

# Database connection
LOGILEAD_DB_URL=postgresql://username:password@localhost:5432/logilead

# SMTP Configuration for email alerts
LOGILEAD_SMTP_HOST=smtp.example.com
LOGILEAD_SMTP_PORT=587
LOGILEAD_SMTP_USER=your_username
LOGILEAD_SMTP_PASS=your_password

# Email alert recipients (comma-separated)
LOGILEAD_ALERT_RECIPIENTS=user1@example.com,user2@example.com
